# Canonical URL for Open Graph / metadata (set in production, e.g. https://docs.example.com)
# NEXT_PUBLIC_DOCS_SITE_URL=https://docs.example.com

# Base URL for "View on GitHub" (blob path to `content/docs/...` in the monorepo). Leave unset to hide the action.
# NEXT_PUBLIC_DOCS_GITHUB_BLOB_BASE=https://github.com/your-org/quokkaq/blob/main

# Outbound links in the docs header + home (same as marketing / frontend). Unset in local dev → localhost:3010 / :3000.
# NEXT_PUBLIC_MARKETING_SITE_URL=https://quokkaq.com
# NEXT_PUBLIC_APP_URL=https://app.quokkaq.com

# Optional: AI chat in docs (`/api/chat`) via OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
